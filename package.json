{
  "name": "ilmucode-vscode",
  "displayName": "ILMUcode Extension",
  "description": "Use ILMU AI chat models in VS Code Chat, with secure API key storage, streamed replies, image input, and Agent tool calls.",
  "version": "0.2.0",
  "publisher": "slumberjer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmadhanis/ilmuchat"
  },
  "engines": {
    "vscode": "^1.127.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:ilmucode",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ilmucode.setApiKey",
        "title": "ILMUcode: Set API Key"
      },
      {
        "command": "ilmucode.startChat",
        "title": "ILMUcode: Start Chat"
      },
      {
        "command": "ilmucode.clearApiKey",
        "title": "ILMUcode: Clear API Key"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "ilmucode",
        "displayName": "ILMUcode",
        "managementCommand": "ilmucode.setApiKey"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.3"
  }
}
